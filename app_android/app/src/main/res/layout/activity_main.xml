<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo">

    <androidx.camera.view.PreviewView
        android:id="@+id/vista"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <bo.lsb.aimara.OverlayView
        android:id="@+id/capa"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Barra superior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#990B0E16"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/titulo"
                android:textColor="@color/texto"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/estado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cargando"
                android:textColor="@color/tenue"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/girar"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/boton"
            android:paddingHorizontal="14dp"
            android:text="@string/girar"
            android:textAllCaps="false"
            android:textColor="@color/texto"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Barra de actividad (a la derecha): se pone naranja mientras graba una seña -->
    <ProgressBar
        android:id="@+id/actividad"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_gravity="top"
        android:layout_marginTop="64dp"
        android:max="150"
        android:progress="0"
        android:progressTint="@color/azul" />

    <!-- Panel inferior con el resultado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/panel"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/palabra"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/esperando"
            android:textColor="@color/texto"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/aimara"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/acento"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/detalle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/tenue"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/instruccion"
            android:textColor="@color/tenue"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
